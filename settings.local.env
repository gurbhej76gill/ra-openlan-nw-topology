# --- App ---
APP_NAME=network-topology-service
APP_ENV=dev
HTTP_PORT=8088
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

# --- Security ---
API_KEY=dev-secret-key

# --- Postgres ---
PG_HOST=localhost
PG_PORT=40061
PG_USER=owanalytics
PG_PASSWORD=owanalytics
PG_DATABASE=owanalytics
PG_SSLMODE=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=1
PG_MAX_CONN_LIFETIME=30m

# --- Topology Windowing ---
TOPOLOGY_WINDOW=1h
TOPOLOGY_DRIFT=2m

# --- Logging ---
LOG_PATH=/var/log/app/app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_LEVEL=info
